# Idea Enhancer - Environment Configuration
# Copy this file to .env and fill in real values.
# Never share or commit your real .env file.

# --- Embedding model for ChromaDB ---
# Must match the model used to build the vector index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DB_PATH=./chroma_db

# --- Live Research providers ---
# GITHUB_TOKEN=

# --- Browser access ---
# CORS_ALLOWED_ORIGINS=https://idea-enhancer.example.edu

# --- Live candidate reranking ---
LIVE_DENSE_SEARCH=1
LIVE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Search startup ---
IDEA_ENHANCER_WARMUP=1

# --- AI idea enhancement (Gemini) ---
# Keep the key on the server only. Never put it in config.js.
GEMINI_API_KEY=paste-your-key-here

# Models to try IN ORDER. If the first is out of quota, slow or fails, the app
# automatically tries the next one. Run `python scripts/check_gemini_models.py`
# to see which ids work for your key, then paste its suggested line here.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
