# Idea Enhancer — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env with real credentials to Git.

# --- Embedding model for ChromaDB ---
# Must match the model used to build the vector index.
# Changing this requires rebuilding the entire ChromaDB index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- ChromaDB persistent storage path ---
CHROMA_DB_PATH=./chroma_db

# --- Live Research providers ---
# GitHub search works without a token at a lower rate limit. Keep real tokens in
# an ignored local .env file; never put them in frontend JavaScript.
# GITHUB_TOKEN=

# --- Browser access ---
# Local frontend origins are always allowed. Add explicitly trusted HTTPS origins
# when hosting the frontend separately; never use '*'.
# CORS_ALLOWED_ORIGINS=https://idea-enhancer.example.edu

# --- Live candidate reranking ---
LIVE_DENSE_SEARCH=1
LIVE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Search startup ---
# Initialize the local dataset, embedding model, and vector index in the background.
# Set to 0 to disable and initialize on the first live search instead.
IDEA_ENHANCER_WARMUP=1

# --- LLM configuration (deferred — uncomment when LLM provider is approved) ---
# LLM_PROVIDER=
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=
