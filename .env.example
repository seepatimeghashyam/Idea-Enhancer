# Idea Enhancer — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env with real credentials to Git.

# --- Embedding model for ChromaDB ---
# Must match the model used to build the vector index.
# Changing this requires rebuilding the entire ChromaDB index.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- ChromaDB persistent storage path ---
CHROMA_DB_PATH=./chroma_db

# --- LLM configuration (deferred — uncomment when LLM provider is approved) ---
# LLM_PROVIDER=
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=
